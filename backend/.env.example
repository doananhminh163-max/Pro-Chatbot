DATABASE_URL="file:./prisma/dev.db"
PORT=8080
NODE_ENV=development

JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

FRONTEND_URL=http://localhost:5173
RESET_PASSWORD_URL=http://localhost:5173/reset-password
APP_NAME=Pro Chatbot

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-app-password
SMTP_FROM=Pro Chatbot <your-email@example.com>

# Optional model placeholder: use {model} or {{model}} or $MODEL in command templates.
GEMINI_CLI_COMMAND=gemini --model={model}
OPENCODE_CLI_COMMAND=opencode run --model={model}
CLI_TIMEOUT_MS=120000

# Sandbox broker
SANDBOX_BROKER_URL=http://127.0.0.1:8091
SANDBOX_BROKER_HOST=127.0.0.1
SANDBOX_BROKER_PORT=8091
SANDBOX_BROKER_TOKEN=replace-with-a-long-random-internal-token
SANDBOX_BROKER_REQUEST_TIMEOUT_MS=120000
SANDBOX_ROOT=D:\Projects\user_docs\sandbox
SANDBOX_JOB_TTL_MS=86400000

# User document storage
USER_DOCS_ROOT=D:\Projects\user_docs\store
