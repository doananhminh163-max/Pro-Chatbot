{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "hostname": "127.0.0.1",
    "port": 4096,
    "cors": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "snapshot": true,
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 100,
      "max_height": 100,
      "max_base64_bytes": 128
    }
  },
  "formatter": true,
  "model": "github-copilot/claude-haiku-4.5",
  "small_model": "github-copilot/claude-haiku-4.5",
  "lsp": {
    "clojure-lsp": {
      "disabled": true
    }
  },
  "watcher": {
    "ignore": [
      "backend/node_modules/**"
    ]
  }
}
